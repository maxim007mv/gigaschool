# КАРКАС — конфигурация окружения (пример; реальные секреты не коммитить)

# --- Cloud.ru Foundation Models (единственный разрешённый LLM-провайдер) ---
# На ВМ хакатона часто заданы OPENAI_BASE_URL / OPENAI_API_KEY — они читаются как алиасы FM_*.
FM_BASE_URL=https://foundation-models.api.cloud.ru/v1
FM_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
MODEL_STRUCT=
MODEL_BULK=
MODEL_EMBED=
MODEL_RERANK=
MODEL_ALLOWLIST=
LLM_CONCURRENCY=2
LLM_TIMEOUT_S=120
LLM_MAX_OUTPUT_TOKENS=4096
# KARKAS_EVAL_API_KEY=  # X-Api-Key для scripts/run_eval.py --live (service)
LLM_CACHE_TTL_H=168

# --- Бюджеты и правила ---
FRAMEWORK_SLO_S=180
KIT_TIMEOUT_MIN=20
MAX_QUESTIONS=5
MIN_ASSESSMENTS_PER_OUTCOME=2
PLAGIARISM_NGRAM=5
PLAGIARISM_MAX_OVERLAP=0.15
DUP_COSINE=0.92

# --- База данных ---
DATABASE_URL=postgresql+asyncpg://karkas:karkas@localhost:5432/karkas

# --- S3 (Cloud.ru Object Storage; локально пусто → LocalStorage) ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_SRC=karkas-src
S3_BUCKET_ART=karkas-artifacts

# --- Аутентификация ---
JWT_SECRET=change-me-in-prod
AGENT_API_KEYS_SHA256=

# --- Egress ---
EGRESS_ALLOWLIST=foundation-models.api.cloud.ru,pypi.org
