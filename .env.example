# КАРКАС — конфигурация окружения (пример; реальные секреты не коммитить)

# --- Cloud.ru Foundation Models (единственный разрешённый LLM-провайдер) ---
FM_BASE_URL=https://hub.gigaschool.ru/api/v1/llm/v1
# Ключ шлюза: FM_API_KEY или LLM_API_KEY (на ВМ хакатона LLM_* уже заданы в окружении).
# Пустое FM_API_KEY= здесь перекрыло бы LLM_API_KEY из окружения, поэтому строка закомментирована.
# FM_API_KEY=
MODEL_STRUCT=GigaChat/GigaChat-3-Pro
MODEL_BULK=GigaChat/GigaChat-3-Pro
MODEL_EMBED=ai-sage/Giga-Embeddings-instruct-3B
MODEL_RERANK=
MODEL_ALLOWLIST=
LLM_CONCURRENCY=2
LLM_TIMEOUT_S=120
LLM_MAX_OUTPUT_TOKENS=4096
LLM_CIRCUIT_FAILURES=10
LLM_CIRCUIT_WINDOW_S=60
LLM_CIRCUIT_COOLDOWN_S=5
# KARKAS_EVAL_API_KEY=  # X-Api-Key для scripts/run_eval.py --live (service)
LLM_CACHE_TTL_H=168

# --- Бюджеты и правила ---
FRAMEWORK_SLO_S=180
KIT_TIMEOUT_MIN=20
MAX_QUESTIONS=5
MIN_ASSESSMENTS_PER_OUTCOME=2
PLAGIARISM_NGRAM=5
PLAGIARISM_MAX_OVERLAP=0.15
DUP_COSINE=0.92

# --- База данных ---
# Демо по умолчанию — SQLite (lite). Для PostgreSQL: KARKAS_LITE=0 и раскомментируйте DATABASE_URL.
KARKAS_LITE=1
# DATABASE_URL=postgresql+asyncpg://karkas:karkas@localhost:5432/karkas

# --- S3 (Cloud.ru Object Storage; локально пусто → LocalStorage) ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_SRC=karkas-src
S3_BUCKET_ART=karkas-artifacts

# --- Аутентификация ---
# JWT_SECRET=<32+ случайных символа>; в prod обязателен, placeholder запрещён.
AGENT_API_KEYS_SHA256=

# --- Egress ---
EGRESS_ALLOWLIST=foundation-models.api.cloud.ru,hub.gigaschool.ru,pypi.org
