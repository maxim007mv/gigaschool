{
  "title": "S07 module_structure",
  "description": "Модули, темы, веса и практичность (Д4 §5.4).",
  "input": {
    "type": "object",
    "properties": {
      "S06": {"type": "object"},
      "competencies": {"type": "array", "items": {"type": "object"}},
      "outcomes": {"type": "array", "items": {"type": "object"}},
      "constraints": {"type": "object"},
      "total_hours": {"type": "integer"}
    }
  },
  "output": {
    "type": "object",
    "required": ["modules"],
    "properties": {
      "modules": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["ref", "title", "topics"],
          "properties": {
            "ref": {"type": "string", "pattern": "^M\\d{1,2}$"},
            "number": {"type": "integer", "minimum": 1},
            "title": {"type": "string"},
            "weight": {"type": "number", "exclusiveMinimum": 0},
            "att_form": {"type": ["string", "null"]},
            "topics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["ref", "title"],
                "properties": {
                  "ref": {"type": "string", "pattern": "^T\\d{1,2}\\.\\d{1,2}$"},
                  "title": {"type": "string"},
                  "summary": {"type": ["string", "null"]},
                  "outcome_refs": {"type": "array", "items": {"type": "string"}},
                  "complexity": {"type": "integer", "minimum": 1, "maximum": 5},
                  "practicality": {"type": "number", "minimum": 0, "maximum": 1},
                  "weight": {"type": "number", "exclusiveMinimum": 0},
                  "has_lab": {"type": "boolean"}
                }
              }
            }
          }
        }
      },
      "gaps": {"type": "array", "items": {"type": "string"}}
    }
  }
}
