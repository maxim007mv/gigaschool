{
  "title": "S12 lecture_plans",
  "description": "План лекции по теме каркаса (Д4 §5.6).",
  "input": {
    "type": "object",
    "required": ["topic"],
    "properties": {
      "topic": {"type": "object", "required": ["ref", "title"]},
      "module_ref": {"type": "string"},
      "outcomes": {"type": "array", "items": {"type": "object"}},
      "S11": {"type": "object"}
    }
  },
  "output": {
    "type": "object",
    "required": ["lecture_plans"],
    "properties": {
      "lecture_plans": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["ref", "topic_ref", "body"],
          "properties": {
            "ref": {"type": "string", "pattern": "^LP-T\\d{1,2}\\.\\d{1,2}$"},
            "kind": {"const": "lecture_plan"},
            "module_ref": {"type": ["string", "null"]},
            "topic_ref": {"type": "string"},
            "title": {"type": "string"},
            "body": {"type": "object"}
          }
        }
      }
    }
  }
}
