{
  "title": "S11 module_programs",
  "description": "Рабочая программа модуля по утверждённому каркасу (Д4 §5.6).",
  "input": {
    "type": "object",
    "required": ["module"],
    "properties": {
      "module": {"type": "object", "required": ["ref", "topics"]},
      "module_ref": {"type": "string"},
      "outcomes": {"type": "array", "items": {"type": "object"}},
      "profile": {"type": "object"},
      "S10": {"type": "object", "description": "отчёт проверки каркаса"}
    }
  },
  "output": {
    "type": "object",
    "required": ["module_programs"],
    "properties": {
      "module_programs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["ref", "module_ref", "body"],
          "properties": {
            "ref": {"type": "string", "pattern": "^MP-M\\d{1,2}(-\\d+)?$"},
            "kind": {"const": "module_program"},
            "module_ref": {"type": "string"},
            "topic_ref": {"type": ["string", "null"]},
            "body": {"type": "object"}
          }
        }
      },
      "notes": {"type": "string"}
    }
  }
}
