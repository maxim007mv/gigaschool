{
  "title": "S17 sources",
  "description": "Кандидаты источников: НПА, литература, интернет, ПО (Д4 §5.7).",
  "input": {
    "type": "object",
    "properties": {
      "topics": {"type": "array", "items": {"type": "object"}},
      "modules": {"type": "array", "items": {"type": "object"}},
      "allowed_normative": {"type": "array", "items": {"type": "string"}},
      "profile": {"type": "object"}
    }
  },
  "output": {
    "type": "object",
    "required": ["sources"],
    "properties": {
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["ref", "section", "citation"],
          "properties": {
            "ref": {"type": "string", "pattern": "^SRC-\\d{1,3}$"},
            "section": {"enum": ["normative", "main", "additional", "internet", "software"]},
            "citation": {"type": "string"},
            "url": {"type": ["string", "null"]},
            "isbn": {"type": ["string", "null"]},
            "normative_act_ref": {"type": ["string", "null"]}
          }
        }
      },
      "notes": {"type": "string"}
    }
  }
}
