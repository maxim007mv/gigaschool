{
  "title": "S14 test_questions",
  "description": "Тестовые вопросы с ключами и привязкой к РО (Д4 §5.6, V-COV-04).",
  "input": {
    "type": "object",
    "properties": {
      "outcomes": {"type": "array", "items": {"type": "object"}},
      "topics": {"type": "array", "items": {"type": "object"}},
      "module": {"type": "object"},
      "count": {"type": "integer", "minimum": 1},
      "profile": {"type": "object"}
    }
  },
  "output": {
    "type": "object",
    "required": ["questions"],
    "properties": {
      "questions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["ref", "stem", "answer_key", "outcome_refs"],
          "properties": {
            "ref": {"type": "string", "pattern": "^Q-\\d{1,3}$"},
            "kind": {"const": "test_question"},
            "topic_ref": {"type": ["string", "null"]},
            "module_ref": {"type": ["string", "null"]},
            "stem": {"type": "string"},
            "qtype": {"enum": ["single", "multiple", "truefalse", "short", "matching", "order", "open"]},
            "options": {"type": "array", "items": {"type": "object"}},
            "answer_key": {"type": "object", "required": ["correct"]},
            "outcome_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "difficulty": {"type": ["integer", "null"], "minimum": 1, "maximum": 5}
          }
        }
      },
      "dropped": {"type": "array", "items": {"type": "string"}},
      "count": {"type": "integer"}
    }
  }
}
