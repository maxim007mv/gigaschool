{
  "title": "S16 final_assessment",
  "description": "Средства итоговой аттестации и текущего контроля (Д4 §5.6).",
  "input": {
    "type": "object",
    "properties": {
      "form": {"type": "string"},
      "outcomes": {"type": "array", "items": {"type": "object"}},
      "profile": {"type": "object"},
      "kind": {"enum": ["dpp_pk", "dop"]},
      "S10": {"type": "object"}
    }
  },
  "output": {
    "type": "object",
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["ref", "kind", "stem", "outcome_refs"],
          "properties": {
            "ref": {"type": "string"},
            "kind": {"enum": ["interview_question", "final_project", "exam_task"]},
            "stem": {"type": "string"},
            "rubric": {"type": "array", "items": {"type": "object"}},
            "outcome_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        }
      },
      "requirements": {"type": "array", "items": {"type": "string"}},
      "form": {"type": "string"},
      "notes": {"type": "string"}
    }
  }
}
