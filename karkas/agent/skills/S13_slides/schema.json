{
  "title": "S13 slides",
  "description": "Структура слайдов по плану лекции (Д4 §5.6).",
  "input": {
    "type": "object",
    "required": ["topic"],
    "properties": {
      "topic": {"type": "object", "required": ["ref"]},
      "module_ref": {"type": "string"},
      "lecture_plan": {"type": "object"},
      "S12": {"type": "object"}
    }
  },
  "output": {
    "type": "object",
    "required": ["slides"],
    "properties": {
      "slides": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["ref", "topic_ref", "body"],
          "properties": {
            "ref": {"type": "string", "pattern": "^SL-T\\d{1,2}\\.\\d{1,2}$"},
            "kind": {"const": "slides"},
            "module_ref": {"type": ["string", "null"]},
            "topic_ref": {"type": "string"},
            "body": {
              "type": "object",
              "properties": {
                "title": {"type": "string"},
                "slides": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {
                    "type": "object",
                    "required": ["title"],
                    "properties": {
                      "title": {"type": "string"},
                      "bullets": {"type": "array", "items": {"type": "string"}, "maxItems": 8},
                      "notes": {"type": "string"}
                    }
                  }
                },
                "source_ref": {"type": ["string", "null"]}
              }
            }
          }
        }
      },
      "notes": {"type": "string"},
      "trimmed": {"type": "integer", "minimum": 0}
    }
  }
}
