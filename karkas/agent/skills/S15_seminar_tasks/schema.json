{
  "title": "S15 seminar_tasks",
  "description": "Задания семинаров с критериями оценки (Д4 §5.6).",
  "input": {
    "type": "object",
    "properties": {
      "topics": {"type": "array", "items": {"type": "object"}},
      "outcomes": {"type": "array", "items": {"type": "object"}},
      "topic": {"type": "object"},
      "module_ref": {"type": "string"},
      "profile": {"type": "object"}
    }
  },
  "output": {
    "type": "object",
    "required": ["tasks"],
    "properties": {
      "tasks": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["ref", "stem", "rubric", "outcome_refs"],
          "properties": {
            "ref": {"type": "string"},
            "kind": {"const": "seminar_task"},
            "topic_ref": {"type": ["string", "null"]},
            "module_ref": {"type": ["string", "null"]},
            "stem": {"type": "string"},
            "rubric": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["criterion", "max_points"],
                "properties": {
                  "criterion": {"type": "string"},
                  "max_points": {"type": "number", "exclusiveMinimum": 0},
                  "levels": {"type": "array", "items": {"type": "string"}}
                }
              }
            },
            "outcome_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        }
      },
      "dropped": {"type": "array", "items": {"type": "string"}},
      "count": {"type": "integer"}
    }
  }
}
